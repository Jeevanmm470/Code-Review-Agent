{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FrontendComponentDesignTestSuite",
  "type": "object",
  "required": ["$schema", "skill", "version", "test_cases"],
  "properties": {
    "$schema": { "type": "string" },
    "skill": { "type": "string", "enum": ["skill-fe-component-design"] },
    "version": { "type": "string" },
    "test_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "target_file", "expected_findings", "expected_score_range", "rationale"],
        "properties": {
          "id": { "type": "string", "pattern": "^TC-[0-9]{3}$" },
          "name": { "type": "string" },
          "target_file": { "type": "string" },
          "expected_findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rule_id", "severity", "line_range"],
              "properties": {
                "rule_id": {
                  "type": "string",
                  "enum": [
                    "FCD01", "FCD02", "FCD03", "FCD04", "FCD05",
                    "FCD06", "FCD07", "FCD08", "FCD09", "FCD10"
                  ]
                },
                "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
                "line_range": {
                  "type": "array",
                  "items": { "type": "integer" },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          },
          "expected_score_range": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "rationale": { "type": "string" }
        }
      }
    }
  }
}

