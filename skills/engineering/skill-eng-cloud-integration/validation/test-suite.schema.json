{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://code-review-portal.internal/schemas/test-suite/v1",
  "title": "TestSuite",
  "description": "Schema for Code Review Portal cloud integration skill validation test suites",
  "type": "object",
  "required": ["suite", "version", "description", "testCases", "coverage"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "URI of the JSON schema"
    },
    "suite": {
      "type": "string",
      "description": "Identifier of the test suite"
    },
    "version": {
      "type": "string",
      "description": "Semantic version of the test suite"
    },
    "description": {
      "type": "string",
      "description": "Summary of the test suite purpose and scope"
    },
    "testCases": {
      "type": "array",
      "description": "List of validation test cases",
      "items": {
        "type": "object",
        "required": ["id", "description", "ruleIds", "technology", "expected"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TC-\\d+[a-z]?$"
          },
          "description": {
            "type": "string"
          },
          "ruleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^CLD(0[1-9]|10)$"
            }
          },
          "technology": {
            "type": "string"
          },
          "inputFile": {
            "type": ["string", "null"]
          },
          "expected": {
            "type": "object",
            "required": ["findingsPresent"],
            "properties": {
              "findingsPresent": {
                "type": "boolean"
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["ruleId", "severity", "confidence"],
                  "properties": {
                    "ruleId": {
                      "type": "string",
                      "pattern": "^CLD(0[1-9]|10)$"
                    },
                    "severity": {
                      "type": "string",
                      "enum": ["critical", "high", "medium", "low"]
                    },
                    "confidence": {
                      "type": "string",
                      "enum": ["high", "medium", "low"]
                    },
                    "evidenceContains": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              },
              "notes": {
                "type": "string"
              },
              "uncertaintyNote": {
                "type": "boolean"
              }
            }
          },
          "safeCounterpart": {
            "type": "object"
          },
          "notApplicableCase": {
            "type": "object"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "rulesWithViolationTest",
        "rulesWithSafeCounterpart",
        "rulesWithNotApplicableCase",
        "technologiesCovered",
        "totalTestCases",
        "violationCases",
        "safeCases"
      ]
    }
  }
}

