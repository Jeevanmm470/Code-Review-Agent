{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillUITailwindCSSTestSuiteSchema",
  "type": "object",
  "required": ["$schema", "suite", "version", "description", "testCases"],
  "properties": {
    "$schema": { "type": "string" },
    "suite": { "type": "string", "const": "skill-ui-tailwind-css" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "testCases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "category", "technology", "inputFile", "targetSymbol", "expected"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "technology": { "type": "string" },
          "inputFile": { "type": "string" },
          "targetSymbol": { "type": "string" },
          "expected": {
            "type": "object",
            "required": ["findingsPresent"],
            "properties": {
              "findingsPresent": { "type": "boolean" },
              "findings": { "type": "array" },
              "notes": { "type": "string" }
            }
          },
          "safeCounterpart": {
            "type": "object",
            "required": ["targetSymbol", "expected"],
            "properties": {
              "targetSymbol": { "type": "string" },
              "expected": {
                "type": "object",
                "required": ["findingsPresent"],
                "properties": {
                  "findingsPresent": { "type": "boolean" },
                  "notes": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}

